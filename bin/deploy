#!/usr/bin/env bash

# Fetch the directory this script is in.
dir=$(cd -P -- "$(dirname -- "$0")" && pwd -P)

# Calculate the tag we wish to use.
branch=$(git branch --show-current)
if [ "$branch" == "develop" ]
then
 branch='latest'
fi

tag="examsys-php-apache:$branch"
repo="uonlearningtech/$tag"

echo "Building $repo"
docker build . --file "$dir/../Dockerfile" --tag "$repo"
echo "Finished building $repo"

echo "Deploying to docker hub $repo"
docker push "$repo"
echo "Finished deploying $repo"

# Build and deploy the version that does not have xDebug turned on
tag="examsys-php-apache:$branch-nodebug"
repo="uonlearningtech/$tag"

echo "Building $repo"
docker build --build-arg APACHE_CONF=rogo-nodebug.ini . --file "$dir/../Dockerfile" --tag "$repo"
echo "Finished building $repo"

echo "Deploying to docker hub $repo"
docker push "$repo"
echo "Finished deploying $repo"
